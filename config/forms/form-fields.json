        "text": "<h2>Graduate Leave Request Details</h2><p></p>",
        "hiddenOnForm": false
      },
      {
        "columnTitle": "__description:c60b46ba",
        "order": 44,
        "itemKind": "description",
        "text": "<p><span style=\"color: rgb(17, 17, 17); font-family: &quot;Inter var&quot;, Arial, Helvetica, sans-serif, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;; font-size: 16px;\">Please answer the following questions regarding your graduate leave request.</span></p>",
        "hiddenOnForm": false
      },
      {
        "columnTitle": "LEAVE START",
        "order": 45,
        "itemKind": "field",
        "hiddenOnForm": false,
        "label": "Semester / Year you request to begin leave:  ",
        "helpText": "Example: Fall 2024"
      },
      {
        "columnTitle": "LEAVE END",
        "order": 46,
        "itemKind": "field",
        "hiddenOnForm": false,
        "label": "Semester / Year you request to return from leave:  ",
        "helpText": "Students may request graduate leave status for up to one calendar year. Leave requests for longer periods of time are granted only for special circumstances.    Example: Fall 2025"
      },
      {
        "columnTitle": "LIBRARY",
        "order": 47,
        "itemKind": "field",
        "hiddenOnForm": false,
        "label": "Do you wish to retain access to the WSU Libraries while on leave?  ",
        "helpText": ""
      },
      {
        "columnTitle": "LEAVE REASONS",
        "order": 48,
        "itemKind": "field",
        "hiddenOnForm": false,
        "label": "Provide the reason(s) for your graduate leave request. Please select all that apply.",
        "kindHint": "multiselect",
        "checkboxColumns": [
